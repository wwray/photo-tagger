# Copy this file to .env and fill in your values
# Never commit the actual .env file — it's already in .gitignore

# Optional: enables AI-powered location suggestions (Claude Haiku)
ANTHROPIC_API_KEY=

# Unraid PUID/PGID for file permissions (99/100 = nobody/users on Unraid)
PUID=99
PGID=100

# Container path the UI pre-fills on load
PHOTO_ROOT=/photos

# Folders the app may read/write (":"-separated). Defaults to /photos.
# Add every extra photo mount here, e.g. /photos:/photos2
#ALLOWED_ROOTS=/photos

# Optional DNS-rebinding defense: the host:port(s) you open the UI with
#ALLOWED_HOSTS=192.168.1.10:5000,tower:5000

# Max AI calls per day (cost control)
AI_DAILY_LIMIT=50

# Model used for AI suggestions. Can also be changed from the UI (⚙️
# Settings) without restarting the container — that overrides this.
AI_MODEL=claude-haiku-4-5
